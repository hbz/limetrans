# MARC/250
add_array("Edition.edition[]")
unless exists("introx.music[]")
  add_array("introx.music[]")
end
do list(path: "250  ", "var": "$i")
  copy_field("$i.a", "@edition")
  replace_all("@edition", "\\s?[=/]$", "")
  if exists("$i.b")
    paste("@edition", "@edition", "$i.b")
  end
  copy_field("@edition", "Edition.edition[].$append")
  copy_field("$i.a", "@music")
  replace_all("@music", "^\\[(.*)\\]$", "$1")
  split_field("@music", ", ")
  do list(path: "@music", "var": "$j")
    lookup("$j", "extended-type-music", delete: "true")
    copy_field("$j", "introx.music[].$append")
  end
  remove_field("@music")
end
