# MARC/210
add_array("AbbreviatedTitle[]")
do list(path: "210??", "var": "$i")
  add_hash("AbbreviatedTitle[].$append")
  call_macro("copy-first-item", source: "$i.a", target: "AbbreviatedTitle[].$last.title")
  call_macro("copy-first-item", source: "$i.b", target: "AbbreviatedTitle[].$last.qualifier")
end
